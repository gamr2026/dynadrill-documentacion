erDiagram
    pumping_tickets {
        uuid id PK
        string code UK
        string status
        string current_step
        uuid pedido_id FK
        uuid taladro_id FK
    }
    pumping_chemicals {
        uuid id PK
        uuid ticket_id FK
        uuid articulo_id FK
        decimal cantidad_asignada
    }
    pumping_tools {
        uuid id PK
        uuid ticket_id FK
        string status
    }
    pumping_operators {
        uuid id PK
        uuid ticket_id FK
        uuid usuario_id FK
    }
    pumping_unit_reports {
        uuid id PK
        uuid ticket_id FK
        uuid unidad_id FK
        uuid pozo_id FK
        date departure_date
    }
    pumping_unit_report_checklist {
        uuid id PK
        uuid report_id FK
        string categoria
        string label
    }
    travel_managements {
        uuid id PK
        uuid ticket_id FK
        string tipo
        string risk_level
    }
    travel_risk_answers {
        uuid id PK
        uuid travel_id FK
        int pregunta_codigo
        int puntaje
    }
    daily_activity_reports {
        uuid id PK
        uuid ticket_id FK
        uuid pozo_id FK
        date fecha
    }
    daily_activity_entries {
        uuid id PK
        uuid report_id FK
        string detalle
    }
    solicitudes_cambio_items {
        uuid id PK
        uuid pumping_ticket_id FK
        uuid pedido_id FK
        string estado
    }
    solicitud_cambio_item_original {
        uuid id PK
        uuid solicitud_id FK
        string codigo
        decimal cantidad
    }
    solicitud_cambio_item_propuesto {
        uuid id PK
        uuid solicitud_id FK
        string codigo
        decimal cantidad
    }

    pumping_tickets ||--o{ pumping_chemicals : ticket_id
