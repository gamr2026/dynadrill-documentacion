  aprobado        Boolean      @default(false)
  // vence_el = capacitacion.fecha + vigenciaMeses — GENERATED o calculado en servicio

  @@unique([capacitacionId, usuarioId])
  @@map("capacitacion_asistentes")
  @@schema("qhse")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEMA: documentos (servicio transversal, confirmado §17.16)
// ─────────────────────────────────────────────────────────────────────────────

model Documento {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidadTipo         String    @map("entidad_tipo") // ej. 'facturacion.pedido', 'qhse.investigacion'
  entidadId           String    @map("entidad_id") @db.Uuid // ref. lógica, cruza schemas
  categoria           String? // ej. 'reporte_job', 'formulario_inspeccion'
  descripcion         String?
  nombreOriginal      String    @map("nombre_original")
  nombreArchivo       String    @unique @map("nombre_archivo")
  mimeType            String    @map("mime_type")
  tamanoBytes         Int       @map("tamano_bytes")
  /// Relativo a la raíz del directorio dedicado del servidor (§17.15) — NO a S3.
  rutaRelativa        String    @map("ruta_relativa")
  version             Int       @default(1)
  documentoAnteriorId String?   @map("documento_anterior_id") @db.Uuid
  documentoAnterior   Documento? @relation("VersionAnterior", fields: [documentoAnteriorId], references: [id])
  versiones           Documento[] @relation("VersionAnterior")
  uploadedBy          String    @map("uploaded_by") @db.Uuid // ref. lógica a auth.usuarios
  uploadedAt          DateTime  @default(now()) @map("uploaded_at")

  @@index([entidadTipo, entidadId])
  @@map("documentos")
  @@schema("documentos")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEMA: notificaciones (servicio transversal, confirmado §17.16)
// ─────────────────────────────────────────────────────────────────────────────

model Notificacion {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidadTipo        String    @map("entidad_tipo")
  entidadId          String    @map("entidad_id") @db.Uuid
  tipo               String // 'cambio_estado' | 'cadena_notificacion_qhse' | 'vencimiento_plazo'
  canal              String    @default("sistema") // 'sistema' | 'email' | 'sms'
  destinatarioId     String?   @map("destinatario_id") @db.Uuid // ref. lógica a auth.usuarios
  destinatarioRolId  String?   @map("destinatario_rol_id") @db.Uuid // ref. lógica a auth.roles
  mensaje            String
  estado             String    @default("pendiente") // 'pendiente'|'enviada'|'leida'|'fallida'

  creadoAt  DateTime  @default(now()) @map("creado_at")
  enviadoAt DateTime? @map("enviado_at")
  leidoAt   DateTime? @map("leido_at")

  @@index([entidadTipo, entidadId])
  @@index([destinatarioId, estado])
  @@map("notificaciones")
  @@schema("notificaciones")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEMA: workflow (servicio transversal, confirmado §17.16)
// ─────────────────────────────────────────────────────────────────────────────

/// Espejo agregado de solo lectura — NO reemplaza el historial de estado local
/// de cada dominio (§10.2), lo complementa para vistas transversales (§6.9).
model EstadoEvento {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidadTipo    String   @map("entidad_tipo")
  entidadId      String   @map("entidad_id") @db.Uuid
  dominio        String // 'facturacion' | 'operaciones_fcr' | ...
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  usuarioId      String   @map("usuario_id") @db.Uuid
  motivo         String?
  fecha          DateTime @default(now())

  @@index([entidadTipo, entidadId])
  @@index([dominio, fecha])
  @@map("estado_eventos")
  @@schema("workflow")
}
