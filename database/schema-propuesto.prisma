}

/// ✅ Nuevo (cubre un vacío detectado, no un campo del diseño anterior): el
/// frontend real (`Investigacion.trabajador?: TrabajadorInvolucrado`) solo
/// llena esto cuando hubo lesionado — se había omitido en la primera versión
/// de este schema. Reusa `maestros.personas` (mismo criterio que EmergenciaHerido).
model InvestigacionTrabajadorInvolucrado {
  investigacionId String        @id @map("investigacion_id") @db.Uuid
