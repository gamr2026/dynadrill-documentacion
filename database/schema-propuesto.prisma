  @@index([emergenciaId, hora])
  @@map("emergencia_timeline")
  @@schema("qhse")
}

model EmergenciaHerido {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emergenciaId String           @map("emergencia_id") @db.Uuid
  emergencia   EmergenciaEvento @relation(fields: [emergenciaId], references: [id], onDelete: Cascade)
  /// ✅ Ref. lógica a maestros.personas cuando el herido es identificable
  /// (empleado o contratista con cédula registrada) — permite agregar por
  /// persona real para LTIR (§16.1), no solo por nombre libre. NULL si es un
  /// tercero no registrado (ej. visitante ocasional) — en ese caso `nombre` es
  /// la única identificación disponible.
  personaId        String?          @map("persona_id") @db.Uuid
  nombre           String
  triageColor      String           @map("triage_color") // 4 colores
  medevacActivado  Boolean          @default(false) @map("medevac_activado")
  medioTransporte  String?          @map("medio_transporte") // 'ambulancia'|'lancha'|'helicoptero'
  hospitalDestino  String?          @map("hospital_destino")
  etaMinutos       Int?             @map("eta_minutos")
  /// ✅ Propuesto §16.1 (LTIR): días de trabajo perdidos, capturado en seguimiento posterior.
  diasPerdidos     Int?             @map("dias_perdidos")

  signosVitales EmergenciaSignoVital[]

  @@index([emergenciaId])
  @@map("emergencia_heridos")
  @@schema("qhse")
}

model EmergenciaSignoVital {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  heridoId String           @map("herido_id") @db.Uuid
  herido   EmergenciaHerido @relation(fields: [heridoId], references: [id], onDelete: Cascade)
  hora     DateTime
  presion  String?
  pulso    Int?
  otros    String?

  @@index([heridoId, hora])
  @@map("emergencia_signos_vitales")
  @@schema("qhse")
}

model EmergenciaNotificacion {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
