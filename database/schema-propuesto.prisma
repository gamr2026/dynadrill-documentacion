model EmergenciaEvento {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nivel                 Int? // 1 | 2 | 3
  estado                String // 'activa' | 'controlada' | 'cerrada'
  origenSwaId           String?  @unique @map("origen_swa_id") @db.Uuid
  origenDerrameId       String?  @map("origen_derrame_id") @db.Uuid
  conteoTotalLocacion   Int?     @map("conteo_total_locacion")
  conteoEvacuados       Int?     @map("conteo_evacuados")
  conteoCompletadoAt    DateTime? @map("conteo_completado_at")
  reporteFlashEnviadoAt DateTime? @map("reporte_flash_enviado_at") // plazo duro de 2h, validado en servicio

  swaOrigen     SwaEvento?         @relation("SwaEscalaEmergencia")
  derrameOrigen DerrameEvento?     @relation("DerrameEscalaEmergencia", fields: [origenDerrameId], references: [id])
  investigacion Investigacion?

  timeline         EmergenciaTimeline[]
  heridos          EmergenciaHerido[]
  notificaciones   EmergenciaNotificacion[]

  @@index([estado])
  @@map("emergencia_eventos")
